# copy to .env and fill in. .env is gitignored - never commit a real key.
# the relay holds this key so the pdf never has to. anyone who opens a pdf can
# read every byte of it, so a key embedded in the document is a published key.

HACKCLUB_AI_KEY=

# optional overrides
#HACKCLUB_AI_URL=https://ai.hackclub.com/proxy/v1/chat/completions
# the leading ~ is part of the model id - it marks a floating alias on the proxy
#HACKCLUB_AI_MODEL=~deepseek/deepseek-v4-flash-latest
